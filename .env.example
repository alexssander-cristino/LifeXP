# LifeXP — ambiente local de desenvolvimento
NODE_ENV=development
PORT=3333
API_BASE_URL=http://localhost:3333
WEB_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Docker Compose publica PostgreSQL em 5438 e Redis em 6388 no host.
DATABASE_URL="postgresql://lifexp:lifexp_password@localhost:5438/lifexp?schema=public"
ENABLE_READ_REPLICA=false
REDIS_URL="redis://localhost:6388"

# Troque estes valores antes de usar em qualquer ambiente compartilhado.
APP_SECRET="lifexp-local-app-secret-change-before-production-32chars"
JWT_ACCESS_SECRET="lifexp-local-access-secret-change-before-production-32chars"
JWT_REFRESH_SECRET="lifexp-local-refresh-secret-change-before-production-32chars"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
REFRESH_TOKEN_ROTATION=true

SESSION_COOKIE_NAME="lifexp_session"
SESSION_COOKIE_DOMAIN=""
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE="lax"
CORS_ORIGIN="http://localhost:5173"

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LifeXP <noreply@lifexp.local>"
EMAIL_ENABLED=false

FCM_PROJECT_ID=""
FCM_CREDENTIALS=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID=""
PUSH_ENABLED=false

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
SUBSCRIPTION_ENABLED=false
LOG_LEVEL=info
