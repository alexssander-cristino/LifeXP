# =============================================================================
# LifeXP — Variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores antes de rodar localmente.
# Nunca commite credenciais reais. Segredos devem vir apenas de variáveis de ambiente.
# =============================================================================

# Ambiente
NODE_ENV=development
PORT=3333
API_BASE_URL=http://localhost:3333
WEB_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Banco de dados principal (escritas)
DATABASE_URL="postgresql://lifexp:lifexp_password@localhost:5432/lifexp?schema=public"

# Réplica de leitura (opcional — descomente e preencha quando houver réplica configurada)
# READ_DATABASE_URL="postgresql://lifexp_reader:lifexp_password@localhost:5433/lifexp?schema=public"
ENABLE_READ_REPLICA=false

# Redis (cache, rate limiting, filas)
REDIS_URL="redis://localhost:6379"

# Segurança — ALTERAR em produção (mínimo 32 caracteres aleatórios)
APP_SECRET="troque-este-secreto-pelo-minimo-32-caracteres-aleatorios"
JWT_ACCESS_SECRET="troque-esta-chave-de-acesso-pelo-minimo-32-caracteres-aleatorios"
JWT_REFRESH_SECRET="troque-esta-chave-de-refresh-pelo-minimo-32-caracteres-aleatorios"

# Tokens
JWT_ACCESS_TTL_SECONDS="900"          # 15 minutos
JWT_REFRESH_TTL_DAYS="30"
REFRESH_TOKEN_ROTATION=true

# Cookies de sessão (web)
SESSION_COOKIE_NAME="lifexp_session"
SESSION_COOKIE_DOMAIN=""
SESSION_COOKIE_SECURE=false           # true em produção (HTTPS)
SESSION_COOKIE_SAME_SITE="lax"

# CORS — origens permitidas (produção: apenas domínios do produto)
CORS_ORIGIN="http://localhost:5173"

# Taxa de requisições (rate limiting)
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="100"

# E-mail (desenvolvimento: Ethereal/SMTP de teste; produção: provedor real)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LifeXP <noreply@lifexp.local>"
EMAIL_ENABLED=false

# Notificações push — preparadas para FCM/APNs (não implementadas por padrão)
FCM_PROJECT_ID=""
FCM_CREDENTIALS=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID=""
PUSH_ENABLED=false

# Assinaturas / pagamentos (integração futura — sem credenciais reais no repositório)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
SUBSCRIPTION_ENABLED=false

# Logs
LOG_LEVEL="info"
