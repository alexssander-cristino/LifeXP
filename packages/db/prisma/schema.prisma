generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// LifeXP — Modelo de dados
//
// Regras de integridade:
//   - Toda entidade pertencente a um usuario tem userId e FK com onDelete: Cascade
//   - Uniqueness constraints evitam duplicacoes (ex: conclusao de missao, log de hábito)
//   - Indices em colunas usadas para filtros/paginacao do dashboard e calendario
// ============================================================================

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EPIC
}

enum MissionType {
  ONE_TIME
  DAILY
  WEEKLY
  CUSTOM
}

enum OccurrenceStatus {
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum Theme {
  DARK
  LIGHT
}

enum AttributeCategory {
  SAUDE
  CONHECIMENTO
  DISCIPLINA
  PRODUTIVIDADE
  FINANCAS
  RELACIONAMENTOS
}

enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

enum NotificationStatus {
  PENDING
  DELIVERED
  FAILED
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum ChallengeType {
  WEEKLY
  MONTHLY
  CUSTOM
}

model User {
  id                    String           @id @default(uuid())
  email                 String           @unique
  passwordHash          String
  name                  String?
  avatarUrl             String?
  timezone              String           @default("UTC")
  dayStartHour          Int              @default(8)
  locale                String           @default("pt-BR")
  theme                 Theme            @default(DARK)
  emailVerified         Boolean          @default(false)
  emailVerifyToken      String?          @unique
  emailVerifyExpires    DateTime?
  passwordResetToken    String?          @unique
  passwordResetExpires  DateTime?
  privacyProfilePublic  Boolean          @default(false)
  dataExportRequestedAt DateTime?
  deletedAt             DateTime?
  xp                    Int              @default(0)    // cache, recalculavel a partir do xp_ledger
  level                 Int              @default(1)    // cache, recalculavel a partir do xp_ledger
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  sessions              Session[]
  refreshTokens         RefreshToken[]
  missions              Mission[]
  missionCompletions    MissionCompletion[]
  habits                Habit[]
  habitLogs             HabitLog[]
  xpLedger              XpLedger[]
  attributes            UserAttribute[]
  userAchievements      UserAchievement[]
  challengeParticipants ChallengeParticipant[]
  notifications         Notification[]
  notificationPreference NotificationPreference?
  auditLogs             AuditLog[]

  @@index([email])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Mission {
  id          String           @id @default(uuid())
  userId      String
  title       String
  description String?
  category    String           @default("geral")
  difficulty  Difficulty       @default(MEDIUM)
  type        MissionType      @default(ONE_TIME)
  // Regra de recorrencia em JSON (ex: { "weekDays": [1,3,5] } para semanal personalizada)
  recurrence  Json?
  dueAt       DateTime?
  xpReward    Int              @default(0)
  goldReward  Int?
  isActive    Boolean          @default(true)
  archivedAt  DateTime?

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences MissionOccurrence[]
  completions MissionCompletion[]

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, type])
  @@map("missions")
}

model MissionOccurrence {
  id          String             @id @default(uuid())
  missionId   String
  userId      String             // desnormalizado para consultas rapidas por usuario
  dueDate     DateTime           // data de vencimento (no fuso do usuario)
  status      OccurrenceStatus   @default(PENDING)
  completedAt DateTime?

  mission     Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  completions MissionCompletion[]

  @@index([missionId])
  @@index([userId, dueDate])
  @@index([userId, status])
  @@unique([missionId, dueDate])
  @@map("mission_occurrences")
}

model MissionCompletion {
  id          String   @id @default(uuid())
  userId      String
  missionId   String
  occurrenceId String?
  completedAt DateTime @default(now())
  xpAwarded   Int
  idempotencyKey String? @unique  // protege contra conclusoes duplicadas (idempotencia)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  occurrence  MissionOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([missionId])
  @@index([completedAt])
  @@map("mission_completions")
}

model XpLedger {
  id          String   @id @default(uuid())
  userId      String
  amount      Int      // positivo (ganho) ou negativo (debito)
  reason      String   // mission_completion | achievement | challenge | adjustment | recalc
  referenceId String?  // id da entidade de origem (missoes_completions, user_achievements, etc.)
  referenceType String?
  levelBefore Int
  levelAfter  Int
  xpBefore    Int
  xpAfter     Int
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([reason])
  @@map("xp_ledger")
}

model UserAttribute {
  id          String              @id @default(uuid())
  userId      String
  category    AttributeCategory
  name        String              // nome configuravel pelo usuario (ex: "Energia", "Leitura")
  currentValue Int                @default(0)
  targetValue Int?
  unit        String?             // ex: "kg", "horas", "pontos"
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, category])
  @@unique([userId, name])
  @@map("user_attributes")
}

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique     // codigo estatico da regra (ex: "first_mission")
  title       String
  description String?
  badgeUrl    String?
  xpReward    Int      @default(0)
  criteria    Json     // definicao da regra de concessao
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id           String   @id @default(uuid())
  userId       String
  achievementId String
  earnedAt     DateTime @default(now())
  notified     Boolean  @default(false)

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement  Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Challenge {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String?
  type        ChallengeType
  startsAt    DateTime
  endsAt      DateTime
  xpReward    Int      @default(0)
  criteria    Json     // definicao do objetivo do desafio
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  participants ChallengeParticipant[]

  @@map("challenges")
}

model ChallengeParticipant {
  id          String   @id @default(uuid())
  userId      String
  challengeId String
  joinedAt    DateTime @default(now())
  completedAt DateTime?
  progress    Json?
  claimed     Boolean  @default(false)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId], name: "userId_challengeId")
  @@index([challengeId])
  @@map("challenge_participants")
}

model Habit {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  category    String?
  frequency   HabitFrequency @default(DAILY)
  // dias da semana (0=domingo..6=sabado) quando frequency = CUSTOM/WEEKLY
  daysOfWeek  Int[]
  targetPerDay Int     @default(1)   // quantas execucoes contam como concluido no dia
  targetWeekly Int?
  isActive    Boolean  @default(true)
  archivedAt  DateTime?

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        HabitLog[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("habits")
}

model HabitLog {
  id        String   @id @default(uuid())
  userId    String
  habitId   String
  logDate   DateTime // data no fuso do usuario (inicio do dia)
  count     Int      @default(1)
  completed Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([habitId])
  @@index([logDate])
  @@unique([userId, habitId, logDate], name: "userId_habitId_logDate")
  @@map("habit_logs")
}

model SystemConfig {
  key       String @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

model Notification {
  id          String                @id @default(uuid())
  userId      String
  type        String                // mission_due | achievement_earned | level_up | habit_reminder | challenge_...
  title       String
  body        String?
  data        Json?
  channel     NotificationChannel @default(IN_APP)
  status      NotificationStatus    @default(PENDING)
  externalId  String?               // id do provedor (FCM/APNs) quando houver confirmacao
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([status])
  @@map("notifications")
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  missionReminders Boolean  @default(true)
  achievementAlerts Boolean @default(true)
  levelUpAlerts    Boolean  @default(true)
  habitReminders   Boolean  @default(true)
  emailEnabled     Boolean  @default(false)
  pushEnabled      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
