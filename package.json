{
  "name": "lifexp",
  "private": true,
  "description": "LifeXP — Plataforma de produtividade pessoal gamificada (RPG style)",
  "version": "1.0.0",
  "author": "LifeXP Team",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/db",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/api & npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "db:generate": "npm run generate --workspace=packages/db",
    "db:migrate:dev": "npm run migrate:dev --workspace=packages/db",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=packages/db",
    "db:seed": "npm run seed --workspace=packages/db",
    "test": "npm run test --workspace=apps/api & npm run test --workspace=apps/web",
    "test:api": "npm run test --workspace=apps/api",
    "test:web": "npm run test --workspace=apps/web",
    "lint": "npm run lint --workspaces",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "packageManager": "npm@10.9.3"
}
